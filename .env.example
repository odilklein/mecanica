# Exibe erros detalhados apenas em desenvolvimento.
APP_DEBUG=false

# Copie este arquivo para .env e ajuste as credenciais do banco
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Obrigatória no docker-compose.yml (o compose não sobe sem ela).
DB_PASS=
DB_NAME=mecanica

# Sessão: encerra após N minutos de inatividade (0 desativa).
SESSION_IDLE_TIMEOUT=120

# Atrás de proxy TLS (nginx/Traefik), defina 1 para respeitar X-Forwarded-Proto
# e marcar o cookie de sessão como Secure. Só habilite se o proxy for confiável.
TRUST_PROXY=0

# Rate-limit de login (opcional)
LOGIN_MAX_TENTATIVAS=5
LOGIN_MAX_IP=20
LOGIN_MAX_EMAIL=10
LOGIN_JANELA_MINUTOS=15

# Seed inicial (opcional). Sem SEED_ADMIN_PASSWORD a migration gera uma
# senha aleatória e imprime no console. Depois use bin/create_admin.php.
SEED_ADMIN_EMAIL=admin@mecanica.com
SEED_ADMIN_PASSWORD=
SEED_PASSWORD=

# Cloudflare Turnstile
# Preencha com os valores do painel da Cloudflare (Turnstile > seu widget).
# NUNCA commite o arquivo .env com valores reais.
TURNSTILE_SITE_KEY=<sua-site-key>
TURNSTILE_SECRET=<sua-secret-key>
# Hostnames autorizados a enviar o token (frontend). Em produção use apenas
# o domínio real; localhost/127.0.0.1 servem para desenvolvimento.
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Groq — transcrição de áudio dos tickets (opcional).
# Deixe vazio para ocultar o botão de áudio e manter apenas a digitação manual.
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# ---------------------------------------------------------------
# Assistente de IA (Groq, OpenAI-compatible)
# Sem chave o chat fica desativado (a tela continua acessível).
# Se LLM_API_KEY estiver vazio, o assistente usa GROQ_API_KEY.
# ---------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_VISION_MODEL=qwen/qwen3.8-27b
LLM_MAX_TOKENS=1024
LLM_MAX_TOKENS_BALANCED=2048
LLM_MAX_TOKENS_DEEP=3072
LLM_TEMPERATURE=0.3

# Modo demonstração: não chama o provedor e usa dados reais do banco.
# NÃO use em produção.
AGENT_MOCK=false

# Limites anti-abuso do assistente.
AGENT_MAX_TURNS_HOUR=120
AGENT_MAX_TURNS_DAY=1000
AGENT_MAX_STEPS=6

# Chave para assinar tokens internos (ofertas de peça, links de aprovação).
# Gere com: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
