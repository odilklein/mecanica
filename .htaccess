# =============================================
# SEGURANCA - Auto Mecanica
# Bloqueia acesso direto a arquivos sensiveis
# =============================================

# Impede listagem de diretorios
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# Bloqueia arquivos sensiveis por extensao
<FilesMatch "\.(env|sql|log|md|sh|ini|bak|old|example)$">
    Require all denied
</FilesMatch>

# Bloqueia arquivos ocultos (.env, .gitignore, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Cabeçalhos de segurança básicos (legado também).
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(self), camera=()"
</IfModule>
