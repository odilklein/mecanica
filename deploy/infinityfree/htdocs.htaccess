# =============================================================================
# Torque Zênitec — InfinityFree
#
# O app vive na raiz de htdocs (src/, vendor/, storage/) e o front controller
# em /public. Esta raiz bloqueia os arquivos internos, aplica os cabeçalhos de
# segurança em TODAS as respostas (inclusive /login) e encaminha as rotas
# para index.php (que ancora SCRIPT_NAME e chama public/index.php).
#
# Este arquivo é versionado em deploy/infinityfree/ e enviado por FTP
# separadamente do pacote da aplicação (não vai no build Docker).
# =============================================================================

# Cabeçalhos de segurança. Ficam na raiz porque o public/.htaccess só é
# aplicado a arquivos servidos de /public — /login e as demais rotas passam
# pelo index.php da raiz e não herdariam os cabeçalhos.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(self), camera=()"

    # HTTPS é obrigatório no host; o HSTS só é enviado quando a conexão é TLS.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com https://viacep.com.br; frame-src https://challenges.cloudflare.com; media-src 'self' blob:; worker-src 'self' blob:"
</IfModule>

Options -Indexes

RewriteEngine On
RewriteBase /

# HTTPS obrigatório.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Nunca servir código, configuração, banco ou arquivos internos.
RewriteRule ^(src|vendor|bin|storage|docs|tests|deploy|sql)(/|$) - [F,L,NC]
RewriteRule ^(\.|composer\.(json|lock)$|README\.md$) - [F,L,NC]

# Assets estáticos do front controller.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(assets|css|js)/(.*)$ public/$1/$2 [L]

# Rotas: tudo o que não é arquivo/diretório real cai no front controller.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
