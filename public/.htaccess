# =============================================
# ROTEAMENTO FRONT CONTROLLER
# Toda requisição que não é arquivo/diretório real
# é encaminhada para o index.php.
# =============================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Se o arquivo/diretório existir fisicamente, serve direto.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Cabeçalhos de segurança básicos.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(self), camera=()"

    # HSTS apenas quando a conexão já é HTTPS (evita travar o http local).
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

    # CSP: restringe origens externas. Os bundles do template usam eval
    # (webpack) e há scripts inline, por isso 'unsafe-eval'/'unsafe-inline'
    # continuam necessários; a migração para nonce/bundles sem eval está no
    # backlog.
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; media-src 'self' blob:; worker-src 'self' blob:"
</IfModule>

# Sem listagem de diretórios.
Options -Indexes

# Limite de upload alinhado ao endpoint de transcrição (25 MB).
<IfModule php_module>
    php_value upload_max_filesize 25M
    php_value post_max_size 25M
</IfModule>
